{
  "name": "aggregor-app",
  "version": "0.0.3",
  "private": true,
  "description": "Combines multiple coding agents.",
  "repository": "github:m-salman-afzal/aggregor",
  "type": "module",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.140.0"
  },
  "scripts": {
    "vscode:prepublish": "vite build --mode production",
    "compile": "pnpm run typecheck && pnpm --workspace-root run lint:check && vite build",
    "watch": "npm-run-all --parallel watch:*",
    "watch:vite": "vite build --watch --mode development",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run typecheck && pnpm --workspace-root run lint:check && vite build --mode production",
    "typecheck": "tsc --noEmit",
    "vsix": "vsce package --no-dependencies --skip-license",
    "publish:vsce": "vsce publish --no-dependencies --skip-license"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.0",
    "@pkg/constants": "workspace:*",
    "@pkg/typings": "workspace:*",
    "effect": "4.1.0"
  },
  "devDependencies": {
    "@pkg/tsconfigs": "workspace:*",
    "@types/node": "26.6.6",
    "@types/vscode": "1.144.0",
    "@vscode/vsce": "4.1.0",
    "npm-run-all2": "9.0.4",
    "vite": "8.3.5"
  },
  "publisher": "SalmanAfzal",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Aggregor App",
      "properties": {
        "aggregorApp.commitCommand": {
          "type": "string",
          "default": "claude -p \"Write the commit message for this staged diff.\" --system-prompt \"You write git commit messages from a staged diff. Reply with the commit message only: no preamble, no code fences, no quotes. Start with a subject line <type>(<scope>): <subject>. type is one of feat, fix, refactor, perf, docs, test, build, ci or chore, whichever matches the main intent of the change. scope is the package or area most of the diff touches, such as extension or constants; leave out (<scope>) when the change spans several areas. subject is in the imperative mood ('add', not 'added'), lowercase, with no trailing period, at most 72 characters, and names the user-visible effect, not the files. Add a body after a blank line only when the subject cannot carry the change: say what changed and why, not how, break its lines so none is longer than 72 characters, and use '- ' bullets for separate changes. Leave the body out for small changes. Only when the diff breaks a public interface or stored data, add ! after the type and a 'BREAKING CHANGE: <what breaks>' footer. Describe only what the diff shows; do not guess at reasons it does not show. No issue numbers, trailers or sign-offs.\" --tools \"\" --no-session-persistence --model claude-haiku-5-5 --effort low",
          "markdownDescription": "Shell command that generates the commit message. It runs in the repository root, receives the staged diff on stdin and must print the message to stdout."
        },
        "aggregorApp.autoCommit": {
          "type": "boolean",
          "default": false,
          "description": "Commit the staged changes right after generating the commit message."
        }
      }
    },
    "submenus": [
      {
        "id": "aggregorApp.sessionActions",
        "label": "More Actions...",
        "icon": "$(ellipsis)"
      },
      {
        "id": "aggregorApp.repoActions",
        "label": "More Actions...",
        "icon": "$(ellipsis)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "aggregorApp.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git && !aggregorApp.isGeneratingCommitMessage"
        }
      ],
      "view/title": [
        {
          "command": "aggregorApp.newSessionInRepo",
          "group": "navigation@1",
          "when": "view == aggregorApp.sessions"
        },
        {
          "command": "aggregorApp.addRepo",
          "group": "navigation@2",
          "when": "view == aggregorApp.sessions"
        }
      ],
      "view/item/context": [
        {
          "submenu": "aggregorApp.sessionActions",
          "group": "inline",
          "when": "view == aggregorApp.sessions && viewItem == session"
        },
        {
          "command": "aggregorApp.newSession",
          "group": "inline@1",
          "when": "view == aggregorApp.sessions && viewItem =~ /^(repo|addedRepo)$/"
        },
        {
          "submenu": "aggregorApp.repoActions",
          "group": "inline@2",
          "when": "view == aggregorApp.sessions && viewItem == addedRepo"
        }
      ],
      "aggregorApp.sessionActions": [
        {
          "command": "aggregorApp.removeSession"
        }
      ],
      "aggregorApp.repoActions": [
        {
          "command": "aggregorApp.removeRepo"
        }
      ],
      "commandPalette": [
        {
          "command": "aggregorApp.newSessionInRepo",
          "when": "false"
        },
        {
          "command": "aggregorApp.openSession",
          "when": "false"
        },
        {
          "command": "aggregorApp.removeSession",
          "when": "false"
        },
        {
          "command": "aggregorApp.removeRepo",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aggregorApp",
          "title": "Aggregor App",
          "icon": "./assets/aggregorLightIcon.svg"
        }
      ]
    },
    "views": {
      "aggregorApp": [
        {
          "id": "aggregorApp.sessions",
          "name": "Sessions",
          "icon": "./assets/aggregorLightIcon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aggregorApp.sessions",
        "contents": "No repos yet.\n[Add Repo](command:aggregorApp.addRepo)\n[Open Folder](command:workbench.action.files.openFolder)"
      }
    ],
    "commands": [
      {
        "title": "Generate auto commit message with AI",
        "command": "aggregorApp.generateCommitMessage",
        "shortTitle": "Auto commit message",
        "icon": {
          "dark": "./assets/aggregorLightIcon.svg",
          "light": "./assets/aggregorDarkIcon.svg"
        }
      },
      {
        "title": "New Claude Session",
        "command": "aggregorApp.newSession",
        "category": "Aggregor App",
        "icon": "$(add)"
      },
      {
        "title": "New Session...",
        "command": "aggregorApp.newSessionInRepo",
        "category": "Aggregor App",
        "icon": "$(add)"
      },
      {
        "title": "Open Session",
        "command": "aggregorApp.openSession",
        "category": "Aggregor App"
      },
      {
        "title": "Remove Session",
        "command": "aggregorApp.removeSession",
        "category": "Aggregor App"
      },
      {
        "title": "Add Repo",
        "command": "aggregorApp.addRepo",
        "category": "Aggregor App",
        "icon": "$(new-folder)"
      },
      {
        "title": "Remove Repo",
        "command": "aggregorApp.removeRepo",
        "category": "Aggregor App"
      }
    ]
  },
  "displayName": "Aggregor App",
  "categories": [
    "AI",
    "Chat",
    "Other"
  ]
}
