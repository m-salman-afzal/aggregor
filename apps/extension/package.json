{
  "name": "aggregor-app",
  "version": "0.0.1",
  "private": true,
  "description": "Combines multiple coding agents.",
  "repository": "github:m-salman-afzal/aggregor",
  "type": "module",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.138.0"
  },
  "scripts": {
    "vscode:prepublish": "vite build --mode production",
    "compile": "pnpm run typecheck && pnpm -w run lint:check && vite build",
    "watch": "npm-run-all -p watch:*",
    "watch:vite": "vite build --watch --mode development",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run typecheck && pnpm -w run lint:check && vite build --mode production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile",
    "typecheck": "tsc --noEmit",
    "test": "vscode-test",
    "vsix": "vsce package --no-dependencies --skip-license",
    "publish:vsce": "vsce publish --no-dependencies --skip-license"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "@effect/platform-node": "4.0.2",
    "@pkg/constants": "workspace:*",
    "@pkg/services": "workspace:*",
    "@pkg/typings": "workspace:*",
    "effect": "4.0.2"
  },
  "devDependencies": {
    "@pkg/tsconfigs": "workspace:*",
    "@types/node": "26.6.4",
    "@types/vscode": "1.140.0",
    "@vscode/vsce": "4.0.0",
    "npm-run-all2": "9.0.3",
    "vite": "8.3.3"
  },
  "publisher": "SalmanAfzal",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Aggregor",
      "properties": {
        "aggregor.commitCommand": {
          "type": "string",
          "default": "claude -p \"Write the commit message for this staged diff.\" --system-prompt \"You write git commit messages. Reply with only the message as <type>(<scope>): <subject>. No prose, no code fences.\" --tools \"\" --no-session-persistence --model haiku",
          "markdownDescription": "Shell command that generates the commit message. It runs in the repository root, receives the staged diff on stdin and must print the message to stdout."
        },
        "aggregor.autoCommit": {
          "type": "boolean",
          "default": false,
          "description": "Commit the staged changes right after generating the commit message."
        }
      }
    },
    "menus": {
      "scm/title": [
        {
          "command": "aggregor.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git && !aggregor.isGeneratingCommitMessage"
        },
        {
          "command": "aggregor.generatingCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git && aggregor.isGeneratingCommitMessage"
        }
      ]
    },
    "commands": [
      {
        "command": "react-webview-vite.openPanel",
        "title": "Open React Webview"
      },
      {
        "title": "Generate auto commit message with AI",
        "command": "aggregor.generateCommitMessage",
        "shortTitle": "Auto commit message",
        "icon": {
          "dark": "./assets/gitCommitLightIcon.svg",
          "light": "./assets/gitCommitDarkIcon.svg"
        }
      },
      {
        "title": "Generating commit message...",
        "command": "aggregor.generatingCommitMessage",
        "shortTitle": "Gen commit msg...",
        "icon": {
          "dark": "./assets/gitCommitLoadingLightIcon.svg",
          "light": "./assets/gitCommitLoadingDarkIcon.svg"
        }
      }
    ]
  },
  "displayName": "Aggregor",
  "categories": [
    "AI",
    "Chat",
    "Other"
  ]
}
