{
  "name": "aggregor-app",
  "version": "0.0.10",
  "private": true,
  "description": "Combines multiple coding agents.",
  "repository": "github:m-salman-afzal/aggregor",
  "type": "module",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.145.0"
  },
  "scripts": {
    "vscode:prepublish": "vite build --mode production",
    "build:pty": "pnpm --filter=aggregor-pty build && mkdir -p bin && cp -f ../pty/target/release/aggregor-pty bin/",
    "compile": "pnpm run typecheck && pnpm --workspace-root run lint:check && pnpm run build:pty && vite build",
    "watch": "npm-run-all --parallel watch:*",
    "watch:vite": "vite build --watch --mode development",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run typecheck && pnpm --workspace-root run lint:check && pnpm run build:pty && vite build --mode production",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "migrationsCopy=$(mktemp --directory) && cp --recursive assets/migrations/. \"$migrationsCopy\" && drizzle-kit generate --dialect sqlite --schema './src/infrastructure/database/models/*.model.ts' --out \"$migrationsCopy\" && { diff --recursive assets/migrations \"$migrationsCopy\" || { echo 'A model changed without its migration: run pnpm db:generate --name <change>'; false; }; }; checkResult=$?; rm --recursive --force \"$migrationsCopy\"; exit $checkResult",
    "test": "vitest run",
    "vsix": "vsce package --no-dependencies --skip-license",
    "publish:vsce": "vsce publish --no-dependencies --skip-license"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@pkg/constants": "workspace:*",
    "@pkg/typings": "workspace:*",
    "@pkg/vscode": "workspace:*",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "jsonc-parser": "catalog:"
  },
  "devDependencies": {
    "@pkg/tsconfigs": "workspace:*",
    "@types/node": "catalog:",
    "@types/vscode": "1.145.0",
    "@vscode/vsce": "catalog:",
    "drizzle-kit": "catalog:",
    "npm-run-all2": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "extensionKind": [
    "workspace"
  ],
  "publisher": "SalmanAfzal",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Aggregor App",
      "properties": {
        "aggregorApp.commitCommand": {
          "type": "string",
          "default": "claude -p \"Write the commit message for this staged diff.\" --system-prompt \"You write git commit messages from a staged diff. Reply with the commit message only: no preamble, no code fences, no quotes. Start with a subject line <type>(<scope>): <subject>. type is one of feat, fix, refactor, perf, docs, test, build, ci or chore, whichever matches the main intent of the change. scope is the package or area most of the diff touches; leave out (<scope>) when the change spans several areas. subject is in the imperative mood ('add', not 'added'), lowercase, with no trailing period, at most 72 characters, and names the user-visible effect, not the files. Add a body after a blank line only when the subject cannot carry the change: say what changed and why, not how, break its lines so none is longer than 72 characters, and use '- ' bullets for separate changes. Leave the body out for small changes. Only when the diff breaks a public interface or stored data, add ! right before the colon and a 'BREAKING CHANGE: <what breaks>' footer. Describe only what the diff shows; do not guess at reasons it does not show. No issue numbers, trailers or sign-offs.\" --tools \"\" --no-session-persistence --model claude-haiku-5-5 --effort low",
          "markdownDescription": "Shell command that generates the commit message. It runs in the repository root, receives the staged diff on stdin and must print the message to stdout."
        },
        "aggregorApp.autoCommit": {
          "type": "boolean",
          "default": false,
          "description": "Commit the staged changes right after generating the commit message."
        },
        "aggregorApp.agents": {
          "type": "object",
          "scope": "machine",
          "default": {
            "claude": {
              "name": "Claude Code",
              "args": [
                "--session-id",
                "${sessionId}"
              ],
              "resumeArgs": [
                "--resume",
                "${sessionId}"
              ],
              "env": {
                "CLAUDE_CODE_TMUX_TRUECOLOR": "1"
              },
              "icon": "assets/agents/claude.svg"
            },
            "codex": {
              "name": "Codex",
              "args": [
                "--no-daemon",
                "-c",
                "tui.terminal_title=[\"thread-title\"]"
              ],
              "resumeArgs": [
                "resume",
                "--no-daemon",
                "-c",
                "tui.terminal_title=[\"thread-title\"]",
                "${agentSessionId}"
              ],
              "icon": "assets/agents/codex.svg"
            },
            "agy": {
              "name": "Antigravity",
              "args": [],
              "resumeArgs": [
                "-c"
              ],
              "icon": "assets/agents/antigravity.svg"
            },
            "opencode": {
              "name": "OpenCode",
              "args": [
                "--session",
                "ses_${sessionId}"
              ],
              "resumeArgs": [
                "--session",
                "ses_${sessionId}"
              ],
              "icon": "assets/agents/opencode.svg"
            },
            "copilot": {
              "name": "GitHub Copilot",
              "args": [
                "--session-id",
                "${sessionId}"
              ],
              "resumeArgs": [
                "--session-id",
                "${sessionId}"
              ],
              "icon": "assets/agents/copilot.svg"
            }
          },
          "additionalProperties": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "Shown in the picker. Defaults to the key."
              },
              "command": {
                "type": "string",
                "description": "The CLI to run. Defaults to the key."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments for a new session. ${sessionId} is the session's id."
              },
              "resumeArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments to reopen a session that has worked. Defaults to args. ${agentSessionId} is the id the agent last showed as its whole terminal title, for an agent that can't start under the session's id."
              },
              "env": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Environment variables the agent starts with, merged with the built-in's."
              },
              "icon": {
                "type": "string",
                "pattern": "\\.(?:[pP][nN][gG]|[sS][vV][gG])$",
                "description": "The path of an SVG or PNG file, absolute or inside the extension. Defaults to Aggregor's logo."
              }
            }
          },
          "markdownDescription": "The agent CLIs a session can run, keyed by command name. Your entries merge with the built-ins: change a field of one, add your own, or set one to `null` to hide it. Only user settings can define them."
        },
        "aggregorApp.defaultAgent": {
          "type": "string",
          "default": "claude",
          "markdownDescription": "The key in `#aggregorApp.agents#` that New Session lists first and selects."
        },
        "aggregorApp.skipAgentPicker": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Start `#aggregorApp.defaultAgent#` straight away instead of asking which agent to use."
        },
        "aggregorApp.notifyOn": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "blocked",
              "done",
              "error",
              "exited",
              "idle",
              "unknown",
              "working"
            ],
            "enumDescriptions": [
              "The agent waits for you: a permission, a question or a sign-in.",
              "The agent finished its turn, or went back to idle after working.",
              "The agent reported an error.",
              "The agent exited.",
              "The agent is idle.",
              "The agent stopped reporting its status.",
              "The agent is working."
            ]
          },
          "uniqueItems": true,
          "default": [
            "blocked",
            "done",
            "error",
            "idle"
          ],
          "markdownDescription": "The states a session out of view notifies about, once it has held one for 3 seconds: inside VS Code when its window is focused, else as a system notification."
        },
        "aggregorApp.traceLogging": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Log every step Aggregor runs, with the fields of each error it meets, even one it handles, to the **Aggregor App** output channel and its log file, whatever log level the channel is set to (unless **Off**). Turn it on to report a problem, reproduce it, and attach the log; the `trace` skill in Aggregor's repository reads it and files the issue."
        }
      }
    },
    "submenus": [
      {
        "id": "aggregorApp.sessionActions",
        "label": "More Actions...",
        "icon": "$(ellipsis)"
      },
      {
        "id": "aggregorApp.projectActions",
        "label": "More Actions...",
        "icon": "$(ellipsis)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "aggregorApp.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "view/title": [
        {
          "command": "aggregorApp.newSessionAskingForProject",
          "group": "navigation@1",
          "when": "view == aggregorApp.sessions"
        },
        {
          "command": "aggregorApp.addProject",
          "group": "navigation@2",
          "when": "view == aggregorApp.sessions"
        },
        {
          "command": "aggregorApp.openSettings",
          "group": "navigation@3",
          "when": "view == aggregorApp.sessions"
        },
        {
          "command": "aggregorApp.stopOngoingSessionAgents",
          "group": "1_agents@1",
          "when": "view == aggregorApp.sessions"
        },
        {
          "command": "aggregorApp.archiveOngoingSessions",
          "group": "1_agents@2",
          "when": "view == aggregorApp.sessions"
        },
        {
          "command": "aggregorApp.stopArchivedSessionAgents",
          "group": "1_agents@1",
          "when": "view == aggregorApp.archive"
        },
        {
          "command": "aggregorApp.newProjectTerminal",
          "group": "navigation",
          "when": "view == terminal"
        }
      ],
      "view/item/context": [
        {
          "submenu": "aggregorApp.sessionActions",
          "group": "inline",
          "when": "view =~ /^aggregorApp\\.(sessions|archive)$/ && viewItem =~ /^session/"
        },
        {
          "command": "aggregorApp.newSessionInChosenProject",
          "group": "inline@1",
          "when": "view == aggregorApp.sessions && viewItem =~ /^(project|addedProject)/"
        },
        {
          "submenu": "aggregorApp.projectActions",
          "group": "inline@2",
          "when": "view =~ /^aggregorApp\\.(sessions|archive)$/ && viewItem =~ /^(project|addedProject)/"
        }
      ],
      "aggregorApp.sessionActions": [
        {
          "command": "aggregorApp.moveSessionUp",
          "group": "1_order@1",
          "when": "viewItem =~ /canMoveUp/"
        },
        {
          "command": "aggregorApp.moveSessionDown",
          "group": "1_order@2",
          "when": "viewItem =~ /canMoveDown/"
        },
        {
          "command": "aggregorApp.stopSessionAgent",
          "group": "2_agents@1",
          "when": "viewItem =~ /agentRunning/"
        },
        {
          "command": "aggregorApp.renameSession",
          "group": "3_session@1"
        },
        {
          "command": "aggregorApp.archiveSession",
          "group": "3_session@2",
          "when": "view == aggregorApp.sessions"
        },
        {
          "command": "aggregorApp.unarchiveSession",
          "group": "3_session@2",
          "when": "view == aggregorApp.archive"
        },
        {
          "command": "aggregorApp.removeSession",
          "group": "3_session@3"
        }
      ],
      "aggregorApp.projectActions": [
        {
          "command": "aggregorApp.moveProjectUp",
          "group": "1_order@1",
          "when": "view == aggregorApp.sessions && viewItem =~ /canMoveUp/"
        },
        {
          "command": "aggregorApp.moveProjectDown",
          "group": "1_order@2",
          "when": "view == aggregorApp.sessions && viewItem =~ /canMoveDown/"
        },
        {
          "command": "aggregorApp.stopProjectSessionAgents",
          "group": "2_agents@1",
          "when": "view == aggregorApp.sessions"
        },
        {
          "command": "aggregorApp.archiveProjectSessions",
          "group": "2_agents@2",
          "when": "view == aggregorApp.sessions"
        },
        {
          "command": "aggregorApp.stopArchivedProjectSessionAgents",
          "group": "2_agents@1",
          "when": "view == aggregorApp.archive"
        },
        {
          "command": "aggregorApp.removeProject",
          "group": "3_project@1",
          "when": "view == aggregorApp.sessions && viewItem =~ /^addedProject/"
        }
      ],
      "commandPalette": [
        {
          "command": "aggregorApp.newSessionInChosenProject",
          "when": "false"
        },
        {
          "command": "aggregorApp.archiveSession",
          "when": "false"
        },
        {
          "command": "aggregorApp.unarchiveSession",
          "when": "false"
        },
        {
          "command": "aggregorApp.archiveProjectSessions",
          "when": "false"
        },
        {
          "command": "aggregorApp.archiveOngoingSessions",
          "when": "false"
        },
        {
          "command": "aggregorApp.stopSessionAgent",
          "when": "false"
        },
        {
          "command": "aggregorApp.stopProjectSessionAgents",
          "when": "false"
        },
        {
          "command": "aggregorApp.stopArchivedProjectSessionAgents",
          "when": "false"
        },
        {
          "command": "aggregorApp.stopOngoingSessionAgents",
          "when": "false"
        },
        {
          "command": "aggregorApp.stopArchivedSessionAgents",
          "when": "false"
        },
        {
          "command": "aggregorApp.openSession",
          "when": "false"
        },
        {
          "command": "aggregorApp.removeSession",
          "when": "false"
        },
        {
          "command": "aggregorApp.removeProject",
          "when": "false"
        },
        {
          "command": "aggregorApp.moveProjectUp",
          "when": "false"
        },
        {
          "command": "aggregorApp.moveProjectDown",
          "when": "false"
        },
        {
          "command": "aggregorApp.moveSessionUp",
          "when": "false"
        },
        {
          "command": "aggregorApp.moveSessionDown",
          "when": "false"
        },
        {
          "command": "aggregorApp.renameSession",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aggregorApp",
          "title": "Aggregor",
          "icon": "./assets/aggregorLightIcon.svg"
        }
      ]
    },
    "views": {
      "aggregorApp": [
        {
          "id": "aggregorApp.sessions",
          "name": "Sessions",
          "icon": "./assets/aggregorLightIcon.svg"
        },
        {
          "id": "aggregorApp.archive",
          "name": "Archive",
          "icon": "./assets/aggregorLightIcon.svg",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aggregorApp.sessions",
        "contents": "No projects yet.\n[Add Project](command:aggregorApp.addProject)"
      },
      {
        "view": "aggregorApp.archive",
        "contents": "Sessions you are done with move here when you archive them from a … menu in the Sessions list: a session's, a project's or the view's."
      }
    ],
    "commands": [
      {
        "title": "Generate auto commit message with AI",
        "command": "aggregorApp.generateCommitMessage",
        "shortTitle": "Auto commit message",
        "enablement": "!aggregorApp.isGeneratingCommitMessage",
        "icon": {
          "dark": "./assets/aggregorLightIcon.svg",
          "light": "./assets/aggregorDarkIcon.svg"
        }
      },
      {
        "title": "New Session",
        "command": "aggregorApp.newSessionInChosenProject",
        "category": "Aggregor App",
        "icon": "$(add)"
      },
      {
        "title": "New Session...",
        "command": "aggregorApp.newSessionAskingForProject",
        "category": "Aggregor App",
        "icon": "$(add)"
      },
      {
        "title": "Open Session",
        "command": "aggregorApp.openSession",
        "category": "Aggregor App"
      },
      {
        "title": "✕\u2003Remove",
        "command": "aggregorApp.removeSession",
        "category": "Aggregor App"
      },
      {
        "title": "Add Project",
        "command": "aggregorApp.addProject",
        "category": "Aggregor App",
        "icon": "$(new-folder)"
      },
      {
        "title": "✕\u2003Remove Project",
        "command": "aggregorApp.removeProject",
        "category": "Aggregor App"
      },
      {
        "title": "New Terminal in Project...",
        "command": "aggregorApp.newProjectTerminal",
        "category": "Aggregor App",
        "icon": "$(root-folder)"
      },
      {
        "title": "✎\u2003Rename",
        "command": "aggregorApp.renameSession"
      },
      {
        "title": "⤓\u2003Archive",
        "command": "aggregorApp.archiveSession"
      },
      {
        "title": "⤒\u2003Unarchive",
        "command": "aggregorApp.unarchiveSession"
      },
      {
        "title": "⤓\u2003Archive Sessions",
        "command": "aggregorApp.archiveProjectSessions"
      },
      {
        "title": "⤓\u2003Archive All Sessions",
        "command": "aggregorApp.archiveOngoingSessions"
      },
      {
        "title": "■\u2003Stop Agent",
        "command": "aggregorApp.stopSessionAgent"
      },
      {
        "title": "■\u2003Stop Agents",
        "command": "aggregorApp.stopProjectSessionAgents"
      },
      {
        "title": "■\u2003Stop Agents",
        "command": "aggregorApp.stopArchivedProjectSessionAgents"
      },
      {
        "title": "■\u2003Stop All Agents",
        "command": "aggregorApp.stopOngoingSessionAgents"
      },
      {
        "title": "■\u2003Stop All Agents",
        "command": "aggregorApp.stopArchivedSessionAgents"
      },
      {
        "title": "∧\u2003Move Up",
        "command": "aggregorApp.moveSessionUp"
      },
      {
        "title": "∨\u2003Move Down",
        "command": "aggregorApp.moveSessionDown"
      },
      {
        "title": "∧\u2003Move Up",
        "command": "aggregorApp.moveProjectUp"
      },
      {
        "title": "∨\u2003Move Down",
        "command": "aggregorApp.moveProjectDown"
      },
      {
        "title": "Open Settings",
        "command": "aggregorApp.openSettings",
        "category": "Aggregor App",
        "icon": "$(gear)"
      }
    ]
  },
  "displayName": "Aggregor App",
  "categories": [
    "AI",
    "Chat",
    "Other"
  ]
}
