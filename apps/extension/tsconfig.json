{
  "extends": "@pkg/tsconfigs/tsconfig.node.json",

  "compilerOptions": {
    //base
    "types": ["node"],

    // One alias per folder under a layer; packages/eslint/src/layers/importRules.ts lists which layer may import each.
    "paths": {
      "@domainServices/*": ["./src/domain/services/*"],
      "@entities/*": ["./src/domain/entities/*"],
      "@valueObjects/*": ["./src/domain/valueObjects/*"],
      "@interfaces/*": ["./src/application/interfaces/*"],
      "@services/*": ["./src/application/services/*"],
      "@dtos/*": ["./src/application/dtos/*"],
      "@config/*": ["./src/infrastructure/config/*"],
      "@models/*": ["./src/infrastructure/database/models/*"],
      "@di/*": ["./src/infrastructure/di/*"],
      "@logger/*": ["./src/infrastructure/logger/*"],
      "@repositories/*": ["./src/infrastructure/repositories/*"],
      "@infraServices/*": ["./src/infrastructure/services/*"],
      "@infraUtils/*": ["./src/infrastructure/utils/*"],
      "@controllers/*": ["./src/presentation/controllers/*"],
      "@middlewares/*": ["./src/presentation/middlewares/*"],
      "@presenters/*": ["./src/presentation/presenters/*"],
      "@presentationUtils/*": ["./src/presentation/utils/*"],
      "@views/*": ["./src/presentation/views/*"]
    }
  },
  "include": ["**/*.ts", "**/*.mts"]
}
