{
  "name": "aggregor",
  "version": "0.0.1",
  "private": true,
  "description": "Combines multiple coding agents.",
  "type": "module",
  "engines": {
    "node": ">=26.8.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.8.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "prepare": "husky & effect-tsgo patch --typescript",
    "watch:extension": "pnpm run --filter=extension",
    "watch:webview": "pnpm run --filter=webview",
    "watch:vite": "pnpm run --filter=extension watch:vite",
    "watch:tsc": "pnpm run --filter=extension watch:tsc",
    "watch": "concurrently \"pnpm run watch:extension\" \"pnpm run watch:webview\"",
    "lint:check": "eslint . --max-warnings 0 --cache --cache-strategy content --concurrency=auto",
    "lint:fix": "eslint . --max-warnings 0 --cache --cache-strategy content --concurrency=auto --fix",
    "format:check": "prettier --check . --cache --cache-strategy content",
    "format:fix": "prettier --write . --cache --cache-strategy content",
    "typecheck": "pnpm -r run typecheck",
    "quality": "pnpm run \"/^(lint:check|format:check|typecheck)$/\""
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "0.8.1",
    "@effect/tsgo": "0.45.0",
    "@eslint/css": "2.0.0",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.0",
    "@eslint/markdown": "8.0.3",
    "@types/eslint-plugin-promise": "7.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-package-json": "1.0.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-perfectionist": "5.12.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.1"
  },
  "categories": [
    "Other"
  ],
  "displayName": "Aggregor",
  "lint-staged": {
    "*": [
      [
        "prettier --check --ignore-unknown",
        "eslint --max-warnings 0 --no-warn-ignored --concurrency=auto"
      ]
    ]
  }
}
