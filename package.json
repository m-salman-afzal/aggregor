{
  "name": "aggregor",
  "version": "0.0.1",
  "description": "Combines multiple coding agents.",
  "type": "module",
  "main": "./dist/extension.js",
  "engines": {
    "node": ">=26.8.1",
    "pnpm": ">=11.25.0"
  },
  "scripts": {
    "prepare": "husky & effect-tsgo patch --typescript",
    "watch:extension": "pnpm run --filter=extension",
    "watch:webview": "pnpm run --filter=webview",
    "watch:vite": "pnpm run --filter=extension watch:vite",
    "watch:tsc": "pnpm run --filter=extension watch:tsc",
    "watch": "concurrently \"pnpm run watch:extension\" \"pnpm run watch:webview\"",
    "check-types": "tsc --noEmit",
    "fmt": "prettier --write . --cache",
    "fmt:check": "prettier --check . --cache",
    "lint": "eslint --cache --concurrency=4",
    "lint:fix": "eslint --fix . --cache --concurrency=4"
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "0.8.0",
    "@effect/tsgo": "0.38.0",
    "@eslint/css": "1.4.0",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.0",
    "@eslint/markdown": "8.0.3",
    "@types/eslint-plugin-promise": "7.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-package-json": "0.3.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-perfectionist": "5.11.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "eslint-plugin-unicorn": "74.0.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.69.0"
  },
  "categories": [
    "Other"
  ],
  "displayName": "Aggregor",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "pnpm run fmt",
      "pnpm run lint"
    ]
  }
}
