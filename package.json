{
  "name": "aggregor-monorepo",
  "version": "0.0.6",
  "private": true,
  "description": "Combines multiple coding agents.",
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "prepare": "husky & effect-tsgo patch --typescript",
    "watch:vite": "pnpm --filter=aggregor-app watch:vite",
    "watch:tsc": "pnpm --filter=aggregor-app watch:tsc",
    "watch": "pnpm --filter=aggregor-app watch",
    "lint:check": "eslint . --max-warnings 0 --cache --cache-strategy content --concurrency=auto",
    "lint:fix": "eslint . --max-warnings 0 --cache --cache-strategy content --concurrency=auto --fix",
    "format:check": "prettier --check . --cache --cache-strategy content",
    "format:fix": "prettier --write . --cache --cache-strategy content",
    "typecheck": "pnpm --recursive run typecheck && tsc --noEmit --project . && tsc --noEmit --project .claude",
    "pty:check": "pnpm --filter=aggregor-pty check",
    "pty:test": "pnpm --filter=aggregor-pty test",
    "quality": "pnpm run \"/^(lint:check|format:check|typecheck|pty:check)$/\"",
    "build": "pnpm --filter=aggregor-app package",
    "vsix": "pnpm --filter=aggregor-app vsix",
    "publish:vsce": "pnpm --filter=aggregor-app publish:vsce",
    "db:generate": "pnpm --filter=aggregor-app db:generate",
    "bump": "bumpp",
    "release:version": "pnpm pkg get version"
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "0.8.1",
    "@effect/tsgo": "0.67.3",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@eslint/markdown": "8.0.3",
    "@types/eslint-plugin-promise": "7.3.0",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "bumpp": "12.3.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-package-json": "3.0.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-unicorn": "79.0.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1"
  },
  "lint-staged": {
    "*": [
      [
        "prettier --check --ignore-unknown",
        "eslint --max-warnings 0 --no-warn-ignored --concurrency=auto"
      ]
    ],
    "*.rs": "rustfmt --check --edition 2024"
  }
}
