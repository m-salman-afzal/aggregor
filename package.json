{
  "name": "aggregor",
  "displayName": "aggregor",
  "version": "0.0.1",
  "description": "Combines multiple coding agents.",
  "categories": [
    "Other"
  ],
  "type": "module",
  "main": "./dist/extension.js",
  "scripts": {
    "prepare": "husky",
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.config.mts",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.config.mts --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.config.mts --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "fmt": "prettier --write . --cache",
    "fmt:check": "prettier --check . --cache",
    "lint": "eslint --cache",
    "lint:fix": "eslint --fix . --cache",
    "test": "vscode-test",
    "sync:git-types": "curl -o src/typings/git.d.ts https://raw.githubusercontent.com/microsoft/vscode/main/extensions/git/src/api/git.d.ts"
  },
  "devDependencies": {
    "@eslint/css": "1.3.0",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.0.0",
    "@eslint/markdown": "8.0.2",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/mocha": "10.0.10",
    "@types/node": "26.x",
    "@types/react": "19.2.17",
    "@types/vscode": "1.125.0",
    "@vscode/test-cli": "0.0.12",
    "@vscode/test-electron": "3.0.0",
    "esbuild": "0.28.1",
    "eslint": "10.5.0",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-perfectionist": "5.9.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.0.8",
    "npm-run-all": "4.1.5",
    "prettier": "3.8.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "pnpm run fmt",
      "pnpm run lint"
    ]
  },
  "contributes": {
    "chatParticipants": [
      {
        "id": "aggregor.cursor",
        "fullName": "Cursor",
        "name": "cursor",
        "description": "Run Cursor as coding agent",
        "isSticky": true
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "aggregor.generateCommitMessage",
          "group": "navigation"
        }
      ]
    },
    "commands": [
      {
        "title": "Generate auto commit message with AI",
        "command": "aggregor.generateCommitMessage",
        "shortTitle": "Auto commit message",
        "icon": {
          "dark": "./assets/gitCommitLightIcon.svg",
          "light": "./assets/gitCommitDarkIcon.svg"
        }
      },
      {
        "title": "Generating commit message...",
        "command": "yamac.generatingCommitMessage",
        "shortTitle": "Gen commit msg...",
        "icon": {
          "dark": "./assets/gitCommitLoadingLightIcon.svg",
          "light": "./assets/gitCommitLoadingDarkIcon.svg"
        }
      }
    ]
  },
  "activationEvents": [],
  "engines": {
    "vscode": "^1.125.0"
  }
}
