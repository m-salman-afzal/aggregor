// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/extension",
        // Turns on the extension's trace-level span lines in the Aggregor App output channel.
        "--log=SalmanAfzal.aggregor-app:trace"
      ],
      // Keeps the dev build's database, tmux server and anchor workspace apart from the installed extension's ~/.aggregor,
      // and draws the Sessions view from apps/webview's dev server, so an edit there shows without a restart.
      "env": {
        "AGGREGOR_HOME": "${userHome}/.aggregorDev",
        "AGGREGOR_WEBVIEW_DEV_SERVER_URL": "http://localhost:5179"
      },
      "outFiles": ["${workspaceFolder}/apps/extension/dist/**/*.js"],
      "preLaunchTask": "${defaultBuildTask}"
    }
  ]
}
