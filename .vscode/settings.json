// Place your settings in this file to overwrite default and user settings.
{
  "prettier.prettierPath": "./node_modules/prettier",
  "prettier.requireConfig": true,
  // rust-analyzer only looks for a Cargo.toml near the workspace root.
  "rust-analyzer.linkedProjects": ["apps/pty/Cargo.toml"],
  // The default commit prompt with aggregor's feature scopes, the ones .github/workflows/pr-title.yaml accepts.
  "aggregorApp.commitCommand": "claude -p \"Write the commit message for this staged diff.\" --system-prompt \"You write git commit messages from a staged diff. Reply with the commit message only: no preamble, no code fences, no quotes. Start with a subject line <type>(<scope>): <subject>. type is one of feat, fix, refactor, perf, docs, test, build, ci or chore, whichever matches the main intent of the change. scope is required: the feature most of the diff changes, one of sessions (the Sessions view, opening, resuming and naming sessions, tmux), projects (the project list), agents (the agent settings and picker), status (aggregor-pty and the status it reports), alerts (notifications and the view's badge), workspace (Aggregor's workspace file), commit-message (generating commit messages), storage (the SQLite database and migrations), lint (the ESLint rules), deps (dependency bumps), release (versions and publishing), or repo for anything no feature covers, such as CI, docs and tooling config. subject is in the imperative mood ('add', not 'added'), lowercase, with no trailing period, at most 72 characters, and names the user-visible effect, not the files. Add a body after a blank line only when the subject cannot carry the change: say what changed and why, not how, break its lines so none is longer than 72 characters, and use '- ' bullets for separate changes. Leave the body out for small changes. Only when the diff breaks a public interface or stored data, add ! right before the colon and a 'BREAKING CHANGE: <what breaks>' footer. Describe only what the diff shows; do not guess at reasons it does not show. No issue numbers, trailers or sign-offs.\" --tools \"\" --no-session-persistence --model claude-haiku-5-5 --effort low",
  "files.exclude": {
    "out": false, // set this to true to hide the "out" folder with the compiled JS files
    "dist": false // set this to true to hide the "dist" folder with the compiled JS files
  },
  "search.exclude": {
    "out": true, // set this to false to include "out" folder in search results
    "dist": true // set this to false to include "dist" folder in search results
  },
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#47000b",
    "activityBar.background": "#47000b",
    "activityBar.foreground": "#e7e7e7",
    "activityBar.inactiveForeground": "#e7e7e799",
    "activityBarBadge.background": "#0f6000",
    "activityBarBadge.foreground": "#e7e7e7",
    "commandCenter.border": "#e7e7e799",
    "sash.hoverBorder": "#47000b",
    "statusBar.background": "#140003",
    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#47000b",
    "statusBarItem.remoteBackground": "#0e6000",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#140003",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#14000399",
    "titleBar.inactiveForeground": "#e7e7e799",
    "activityBarTop.activeBackground": "#47000b",
    "activityBarTop.background": "#47000b",
    "activityBarTop.foreground": "#e7e7e7",
    "activityBarTop.inactiveForeground": "#e7e7e799",
    "commandCenter.foreground": "#e7e7e7",
    "statusBar.debuggingBackground": "#140003",
    "statusBar.debuggingForeground": "#e7e7e7",
    "activityBar.activeBorder": "#e7e7e7",
    "activityBarTop.activeBorder": "#e7e7e7",
    "statusBar.inactiveBackground": "#140003"
  },
  "peacock.color": "#140003",

  // Effect LSP: point the TS7 native server at the effect-tsgo-patched native exe.
  // ponytail: the exe, not ./node_modules/@typescript/native/bin/tsc — that shim is
  // #!/usr/bin/env node and the extension host has no node on PATH (nvm).
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "./node_modules/.pnpm/node_modules/@typescript/typescript-linux-x64/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.tsdk.additionalLocations": ["./node_modules/.pnpm/node_modules/@typescript/typescript-linux-x64/lib"]
}
