{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
    "schedule:weekly",
    ":semanticCommits",
    ":semanticCommitTypeAll(build)",
    "group:allNonMajor",
  ],
  ignorePresets: ["helpers:pinGitHubActionDigests"],
  timezone: "Asia/Karachi",
  postUpdateOptions: ["pnpmDedupe"],
  osvVulnerabilityAlerts: true,
  dependencyDashboard: {
    osvVulnerabilitySummary: "unresolved",
  },
  packageRules: [
    {
      matchUpdateTypes: ["major", "minor", "patch"],
      minimumReleaseAge: "1 day",
    },
    {
      matchDepNames: ["husky", "portable-pty"],
      abandonmentThreshold: null,
    },
    {
      groupName: "GitHub Actions",
      matchManagers: ["github-actions"],
      semanticCommitType: "ci",
    },
    {
      groupName: "VS Code",
      matchDepNames: ["vscode", "@types/vscode"],
      rangeStrategy: "bump",
    },
    {
      matchDepNames: ["vscode"],
      matchUpdateTypes: ["patch"],
      enabled: false,
    },
    {
      matchDepNames: ["drizzle-orm", "drizzle-kit"],
      allowedVersions: "!/-[0-9a-f]{7}$/",
    },
  ],
}
